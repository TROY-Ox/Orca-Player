<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!-- Extensions run here, apart from the UI and playback, so a crash or hang can't take
             the app down (19.3). -->
        <service
            android:name=".host.ExtensionService"
            android:exported="false"
            android:process=":extensions" />
    </application>
</manifest>
