<?xml version="1.0" encoding="utf-8"?>
<!-- Secrets, the private folder and downloads are excluded from cloud backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="private/" />
        <exclude domain="file" path="downloads/" />
        <exclude domain="file" path="secure/" />
        <exclude domain="sharedpref" path="orca_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="private/" />
        <exclude domain="file" path="secure/" />
    </device-transfer>
</data-extraction-rules>
