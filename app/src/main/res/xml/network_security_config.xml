<?xml version="1.0" encoding="utf-8"?>
<!-- Many addons, links, LAN servers and network shares use http://. Cleartext is allowed,
     and http sources show an "insecure connection" badge in the UI. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
